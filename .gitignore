# Workspace-only files. Nothing here is needed to deploy the app.
# See DEPLOY.md for what a deployment uses.

# Local platform/type cache for the editor (~870 MB, rebuilt automatically)
.vs-cache/

# Generated by the C3 platform from src/ (rebuilt on every validation)
pkge09c9761/gen/
**/.fingerprints.txt

# Dependency lock written by the workspace; the platform re-resolves dependencies on deploy
*.c3pkg.lock.json

# Editor / agent settings for this workspace
.vscode/
.claude/
.github/copilot-instructions.md
**/jsconfig.json

# Scratch space (Python venv for data generation, ~640 MB)
.tmp/

# npm installs and build output (rebuilt from package-lock.json)
node_modules/
**/ui/content/
dist/
coverage/

# Secrets and OS clutter
.env
.env.*
*.log
.DS_Store
